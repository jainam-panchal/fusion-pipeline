    {
      "id": 8,
      "type": "table",
      "title": "Where did my logs go: drops by stage and reason",
      "description": "Every record a stage chose not to forward in the time range, by the node that dropped it and the reason. `source` is the pipeline's intake: `missing_id` messages have no `Fusion-Record-Id`, `invalid_record` ones have a `Fusion-Record-Kind` that is not `log` or cannot be read.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "stage": "Stage",
              "reason": "Reason",
              "Value": "Records"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (stage, reason) (increase(records_dropped_total{tenant=\"$tenant\"}[$__range])) > 0",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ]
