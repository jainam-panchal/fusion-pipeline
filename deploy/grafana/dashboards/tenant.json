            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(records_in_total{tenant=\"$tenant\", stage=\"source\"}[$__rate_interval]))",
          "legendFormat": "in",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (stage) (rate(records_out_total{tenant=\"$tenant\"}[$__rate_interval]) and on (tenant, stage) bytes_out_total{tenant=\"$tenant\"})",
          "legendFormat": "written to {{stage}}",
          "range": true,
          "instant": false
        }
