          "expr": "histogram_quantile(0.5, sum by (le) (rate(stage_duration_seconds_bucket{tenant=~\"$tenant\",stage=\"$stage\"}[1m]) or rate(sink_publish_duration_seconds_bucket{tenant=~\"$tenant\",stage=\"$stage\"}[1m])))",
