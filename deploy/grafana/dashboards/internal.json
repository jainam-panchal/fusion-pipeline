          },
          "expr": "sum by (reason) (rate(records_dropped_total{tenant=~\"$tenant\",stage=\"$stage\"}[1m]))",
          "legendFormat": "dropped: {{reason}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(records_errored_total{tenant=~\"$tenant\",stage=\"$stage\"}[1m]))",
          "legendFormat": "errored",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(sink_publish_errors_total{tenant=~\"$tenant\",stage=\"$stage\"}[1m]))",
          "legendFormat": "no PubAck",
          "refId": "C"
        }
      ]
    },
    {
      "id": 12,
