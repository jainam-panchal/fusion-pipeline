    {
      "id": 9,
      "type": "timeseries",
      "title": "Records in / out",
      "description": "What this node did with its records. For source: intake and the engine's own drops. For a sink: out means PubAck.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "min": 0,
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "in"
            },
            "properties": [
