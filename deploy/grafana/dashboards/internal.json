    {
      "id": 1001,
      "type": "timeseries",
      "title": "Handed over \u2192 entered the graph \u2192 rejected",
      "description": "Every record the source handed to the engine; those with an id and of kind log entered the first stage; the rest were rejected here (missing_id naks and comes back, invalid_record acks and is gone).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
